{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Invoice (GET /invoices/{id})",
  "type": "object",
  "required": ["id", "invoice_number", "invoice_date", "billing_street", "billing_city", "billing_country",
               "billing_postal_code", "subtotal", "total", "status", "user_id", "invoicelines", "payment"],
  "properties": {
    "id": { "type": "string" },
    "invoice_number": { "type": "string", "pattern": "^INV-[0-9]+$" },
    "invoice_date": { "type": "string" },
    "billing_street": { "type": "string" },
    "billing_city": { "type": "string" },
    "billing_country": { "type": "string" },
    "billing_postal_code": { "type": "string" },
    "subtotal": { "type": "number", "minimum": 0 },
    "total": { "type": "number", "minimum": 0 },
    "status": { "type": "string" },
    "user_id": { "type": "string" },
    "invoicelines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["product_id", "unit_price", "quantity", "product"],
        "properties": {
          "product_id": { "type": "string" },
          "unit_price": { "type": "number", "minimum": 0 },
          "quantity": { "type": "integer", "minimum": 1 },
          "product": { "$ref": "product.json#" }
        }
      }
    },
    "payment": {
      "type": "object",
      "required": ["payment_method"],
      "properties": { "payment_method": { "type": "string" } }
    }
  }
}
