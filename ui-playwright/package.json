{
  "name": "ui-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "UI and cross-layer tests for the Toolshop demo app with Playwright Test",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  }
}
